# ── Variables d'environnement requises ────────────────────────────
# Copier ce fichier en .env et remplir les valeurs

# Brevo (email API)
BREVO_API_KEY=your_brevo_api_key_here

# JWT
JWT_SECRET=segula-saas-super-secret-key-2024-must-be-at-least-32-chars

# URLs
FRONTEND_URL=http://localhost:4200
MAIL_FROM=your_email@domain.com

# Base de donnees (local)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=root
POSTGRES_DB=project_saas
